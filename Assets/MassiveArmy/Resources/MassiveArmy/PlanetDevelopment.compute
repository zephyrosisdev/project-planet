#ifdef PLANET_CROWD
#define _PlanetCrowdEnabled 1u
#else
#define _PlanetCrowdEnabled 0u
#endif
#pragma multi_compile _ PLANET_ENCOUNTERS
#ifdef PLANET_ENCOUNTERS
StructuredBuffer<float4> _PlanetSteering;
StructuredBuffer<uint> _PlanetActivity,_PlanetActiveIndices,_PlanetActiveCounts;RWStructuredBuffer<uint> _PlanetLastSimulationTick;uint _PlanetInterestEnabled,_PlanetInterestTick;
#endif
#include "ArmyCommon.hlsl"
