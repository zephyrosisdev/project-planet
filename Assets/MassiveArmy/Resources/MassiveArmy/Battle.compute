}
[numthreads(128,1,1)]
void ResolveContacts(uint3 id:SV_DispatchThreadID) {
    uint i=id.x;if(i>=_Active)return;UnitState u=_Read[i];
    SetTraversalTeam(Team(u));
    if((u.flags&ALIVE)==0 || (u.flags&(STOPPED|32768))!=0) { _Next[i]=u;return; }
    // Match the staggered distant walk steps. Nearby walkers and all pursuers
    // retain normal contact updates; no simulation identities are culled.
#ifdef ZOMBIES
    if((u.flags&ZOMBIE_WANDERING)!=0){if(_UseLod!=0&&WorldDistance(u.position,_RenderFocus.xz,_WorldSize)>1400&&(i+_Tick)%6!=0){_Next[i]=u;return;}}
#endif
    float radius=_Types[Type(u)].radius;float2 correction=0;float weightSum=0;uint examined=0;
    int rings=min(4,(int)ceil((radius*3.5+.5)/(_WorldSize/_ContactRes)));
    int2 cell=ContactCoordinate(u.position);
    [loop] for(int ring=0;ring<=rings;ring++) [loop] for(int y=-ring;y<=ring;y++) [loop] for(int x=-ring;x<=ring;x++) {
        if(max(abs(x),abs(y))!=ring)continue;int2 c=WrapCell(cell+int2(x,y),_ContactRes);
        uint ci=c.x+c.y*_ContactRes,count=_ContactCounts[ci],take=min(count,128u),begin=count>take?ArmyHash(i+23)%count:0;
        [loop] for(uint j=0;j<take && examined<128;j++,examined++) {
            uint other=_ContactIndices[_ContactOffsets[ci]+(begin+j)%count];if(other==i)continue;
            UnitState v=_Read[other];if((v.flags&ALIVE)==0 || IgnoreFriendly(u,v))continue;if(_BaseMode!=0&&((_Types[Type(u)].movement==3)!=(_Types[Type(v)].movement==3)))continue;
            float2 delta=WorldDelta(v.position,u.position,_WorldSize);float d=length(delta),contact=radius+_Types[Type(v)].radius+.5;
            if(d<contact) {
                float2 normal=PairNormal(i,other,delta,d);
                bool constrained=(v.flags&STOPPED)!=0 || IgnoreFriendly(v,u) ||
                    !ClearTerrainSegmentForTeam(v.position,v.position-normal*(contact-d)*.5,_Types[Type(v)].movement,Team(v));
                float weight=constrained?1:.5;
                correction+=normal*(contact-d+.0005)*weight;weightSum+=weight;
            }
        }
    }
    correction/=max(1,weightSum);
    correction=SafeNormal(correction)*min(length(correction)*.8,radius*.5);
    if(dot(correction,correction)<.000009)correction=0;
    // Movement already published a canonical position. With no correction,
    // terrain checks of the identical endpoint cannot change position/velocity.
    if(dot(correction,correction)==0){_Next[i]=u;return;}
    float2 proposed=u.position+correction;
    uint movement=_Types[Type(u)].movement;
    if(!ClearTerrainSegment(u.position,proposed,movement)) {
        float2 alongX=u.position+float2(correction.x,0),alongY=u.position+float2(0,correction.y);
        bool xClear=ClearTerrainSegment(u.position,alongX,movement),yClear=ClearTerrainSegment(u.position,alongY,movement);
        if(xClear && (!yClear || abs(correction.x)>abs(correction.y)))proposed=alongX;
        else if(yClear)proposed=alongY;
        correction=proposed-u.position;
    }
    if(ClearTerrainSegment(u.position,proposed,movement)) {
        u.position=WrapPosition(proposed,_WorldSize);
        if(dot(u.velocity,correction)<0) { float2 n=SafeNormal(correction);u.velocity-=n*dot(u.velocity,n); }
    }
    _Next[i]=u;
}
[numthreads(1,1,1)]
void ClearPick(uint3 id:SV_DispatchThreadID) { _Pick[0]=INVALID; }
[numthreads(128,1,1)]
void FindPick(uint3 id:SV_DispatchThreadID) {
    uint i=id.x; if(i>=_Active) return;
#ifdef ZOMBIES
    UnitState u=_Units[i]; if((u.flags&ALIVE)==0 || (u.flags&32768)!=0 || (_PickTeam==0?Team(u)!=0:Team(u)==0)) return;
    if(_BaseMode!=0&&_PickTeam!=0&&!TargetKnown(u,0))return;
#else
    UnitState u=_Units[i];if((u.flags&ALIVE)==0||(u.flags&32768)!=0||Team(u)!=_PickTeam)return;
#endif
    float4 clip=mul(_ViewProjection,float4(NearestWorld(WorldPosition(u),_RenderFocus,_WorldSize),1)); if(clip.w<=0) return;
    float2 screen=(clip.xy/clip.w*.5+.5)*_ScreenSize;
    float2 mouse=_SelectionRect.xy*_ScreenSize;
    float d2=dot(screen-mouse,screen-mouse);
    if(d2<196) InterlockedMin(_Pick[0],((uint)(d2*16)<<20)|i);
}
[numthreads(128,1,1)]
void SelectUnits(uint3 id:SV_DispatchThreadID) {
    uint i=id.x; if(i>=_Active) return;
    UnitState u=_Units[i]; if((u.flags&(ALIVE|32768))!=ALIVE || Team(u)!=0) return;
    float4 clip=mul(_ViewProjection,float4(NearestWorld(WorldPosition(u),_RenderFocus,_WorldSize),1));
    float2 screen=clip.xy/max(clip.w,.00001)*.5+.5;
    bool inside=_ClickSelection!=0 ? (_Pick[0]!=INVALID && (_Pick[0]&0xfffffu)==i)
        : clip.w>0 && all(screen>=_SelectionRect.xy) && all(screen<=_SelectionRect.zw);
    if(_SelectionOperation==0) u.flags&=~SELECTED;
    if(inside) { if(_SelectionOperation==2) u.flags&=~SELECTED; else u.flags|=SELECTED; }
    _Units[i]=u;
}
[numthreads(128,1,1)]
void ApplyOrders(uint3 id:SV_DispatchThreadID) {
    uint i=id.x; if(i>=_Active) return;
    UnitState u=_Units[i]; if((u.flags&(ALIVE|SELECTED))!=(ALIVE|SELECTED) || Team(u)!=0 || !OrderMatches(u)) return;
    u.flags&=~(4096u|STRUCTURE_ORDER);u.target=INVALID;
    if(_Order==3) { u.flags&=~(ARRIVED|FORMATION_ENTRY|PASS_RIGHT|PASS_LEFT);u.flags|=STOPPED; u.velocity=0; u.destination=u.position; u.group=INVALID; }
    else {
        if(_Groups[_CommandGroup].padding!=0)return;
        u.group=_CommandGroup; u.flags&=~(STOPPED|ATTACK_MOVE|DIRECT_ROUTE|ARRIVED|DETOUR_ROUTE|ROUTE_TRACKED|FORMATION_ENTRY|PASS_RIGHT|PASS_LEFT); u.flags|=FORMATION;
        if(_Order==1 || _Order==2) u.flags|=ATTACK_MOVE;
        u.destination=_FormationSlots[_CombinedFormation!=0?_CombinedRanks[i]:_SelectedRanks[i]];
        if(_Order==2 && _Pick[0]!=INVALID) u.target=_Pick[0]&0xfffffu;
        if(_StructureTarget!=INVALID){u.target=STRUCTURE_TARGET|_StructureTarget;u.flags|=STRUCTURE_ORDER;}
    }
    _Units[i]=u;
}
[numthreads(128,1,1)]
void AcquireTargets(uint3 id:SV_DispatchThreadID) {
    uint i=id.x; if(i>=_Active) return;
    UnitState u=_Units[i]; if((u.flags&ALIVE)==0||(u.flags&32768)!=0) return;
    UnitArchetype t=_Types[Type(u)];
    #ifdef ZOMBIES
    uint zombieStructure=INVALID;
    #endif
    if(_BaseMode!=0&&u.target!=INVALID&&(u.target&STRUCTURE_TARGET)!=0) {
        uint b=u.target&~STRUCTURE_TARGET;
        #ifdef ZOMBIES
        if(IsZombie(u)&&b<_BuildingCount&&_Structures[b].health>0&&_Structures[b].team!=Team(u))zombieStructure=u.target;
        #endif
        if(b<_BuildingCount&&_Structures[b].health>0&&_Structures[b].team!=Team(u)&&!IsZombie(u)&&((u.flags&STRUCTURE_ORDER)!=0||WorldDistance(u.position,_Structures[b].position,_WorldSize)-_Structures[b].radius<=t.attackRange))return;
        u.target=INVALID;u.flags&=~STRUCTURE_ORDER;
    }
    bool valid=false;
    if(u.target<_Active) {
        UnitState target=_Units[u.target];
        valid=(target.flags&ALIVE)!=0 && Team(target)!=Team(u) && WorldDistance(u.position,target.position,_WorldSize)<=t.acquisitionRange && TargetAllowed(u,target);
    }
    if(!valid) u.target=INVALID;
    if((i+_Tick)%_TargetSlices==0 && _UseGrid!=0 && !valid) {
        int2 centre=GridCoordinate(u.position);
        int radius=(int)ceil(t.acquisitionRange/(_WorldSize/_GridRes))+1;
        float best=t.acquisitionRange*t.acquisitionRange; uint examined=0;
        // Rotate the cell traversal each scan to avoid starving a dense far side.
        uint side=radius*2+1, total=side*side, start=ArmyHash(i+_Tick/_TargetSlices)%total;
        [loop] for(uint c=0;c<total && examined<_TargetBudget;c++) {
            uint offset=(start+c)%total;
            int2 cell=WrapCell(centre+int2(offset%side,offset/side)-radius,_GridRes);
            if(!CellValid(cell)) continue;
            uint ci=cell.x+cell.y*_GridRes, count=_CellCounts[ci];
            uint take=min(count,8u), begin=count>0?ArmyHash(i+ci+_Tick)%count:0;
            [loop] for(uint j=0;j<take && examined<_TargetBudget;j++,examined++) {
                uint other=_Indices[_CellOffsets[ci]+(begin+j*max(1u,count/take))%count];
                UnitState v=_Units[other]; if((v.flags&ALIVE)==0 || Team(v)==Team(u) || !TargetAllowed(u,v)) continue;
                float2 d=WorldDelta(u.position,v.position,_WorldSize); float d2=dot(d,d);
                if(d2<best) { best=d2; u.target=other; }
            }
        }
    }
#ifdef ZOMBIES
    if((u.flags&ZOMBIE_UNIT)!=0&&u.target<_Active){u.destination=_Units[u.target].position;u.flags=(u.flags|ATTACK_MOVE)&~(STOPPED|ARRIVED|STRUCTURE_ORDER|ZOMBIE_WANDERING);}
    else if(u.target==INVALID&&zombieStructure!=INVALID){u.target=zombieStructure;u.flags=(u.flags|STRUCTURE_ORDER)&~ZOMBIE_WANDERING;}
#endif
    _Units[i]=u;
}
[numthreads(128,1,1)]
void FireWeapons(uint3 id:SV_DispatchThreadID) {
    uint i=id.x; if(i>=_Active) return;
    UnitState u=_Units[i]; if((u.flags&ALIVE)==0||(u.flags&(32768|8192))!=0) return;
    UnitArchetype t=_Types[Type(u)]; u.cooldown=max(0,u.cooldown-_Delta);
    if(_BaseMode!=0&&u.target!=INVALID&&(u.target&STRUCTURE_TARGET)!=0) {
        uint b=u.target&~STRUCTURE_TARGET;
        if(b<_BuildingCount&&_Structures[b].health>0&&WorldDistance(u.position,_Structures[b].position,_WorldSize)-_Structures[b].radius<=t.attackRange){float2 delta=WorldDelta(u.position,_Structures[b].position,_WorldSize);float angle=atan2(delta.x,delta.y);u.turret=Turn(u.turret,angle,t.turnSpeed*2*_Delta);u.facing=Turn(u.facing,angle,t.turnSpeed*2*_Delta);}
        _Units[i]=u;return;
    }
    if(_BaseMode!=0&&(_Logistics!=0||t.movement==3)&&_Operations[i].ammo<1){_Units[i]=u;return;}
    if(u.target<_Active) {
        UnitState enemy=_Units[u.target]; float2 delta=WorldDelta(u.position,enemy.position,_WorldSize);
        float angle=atan2(delta.x,delta.y); u.turret=Turn(u.turret,angle,t.turnSpeed*2*_Delta);
        if(dot(delta,delta)<=t.attackRange*t.attackRange)u.facing=Turn(u.facing,angle,t.turnSpeed*2*_Delta);
        float aim=abs(atan2(sin(angle-u.turret),cos(angle-u.turret)));
        if(_BaseMode!=0)aim=max(aim,abs(atan2(sin(angle-u.facing),cos(angle-u.facing))));
        if((enemy.flags&ALIVE)!=0 && Team(enemy)!=Team(u) && dot(delta,delta)<=t.attackRange*t.attackRange && aim<t.aimTolerance && u.cooldown<=0 && TargetAllowed(u,enemy)) {
            bool fired=false;
            if(_BaseMode!=0 && _Traits[Type(u)].role==8){
                [loop]for(uint attempt=0;attempt<32;attempt++){uint at=(i+attempt+_Tick)%32,claim;InterlockedCompareExchange(_Missiles[at].alive,0,1,claim);if(claim!=0)continue;ProjectileState missile=(ProjectileState)0;missile.position=WorldPosition(u);missile.velocity=WorldPosition(enemy);missile.lifetime=12;missile.damage=t.damage;missile.team=Team(u);missile.alive=1;missile.owner=i;missile.target=(uint)_Traits[Type(u)].splash;_Missiles[at]=missile;fired=true;break;}
            }else if(_UseProjectiles!=0 && t.weapon==1) {
                // Bounded, lock-free pool. A failed claim delays this shot; damage is never fabricated.
                [unroll] for(uint attempt=0;attempt<4;attempt++) {
                    uint slot=ArmyHash(i+_Tick*103+attempt*7919)%_ProjectileCapacity, previous;
                    InterlockedCompareExchange(_Projectiles[slot].alive,0,1,previous);
                    if(previous!=0) continue;
                    float3 origin=WorldPosition(u)+float3(sin(u.turret)*2,1.3,cos(u.turret)*2);
                    float3 destination=NearestWorld(WorldPosition(enemy),origin,_WorldSize);
                    ProjectileState p;
                    p.position=origin; p.lifetime=3;
                    p.velocity=normalize(destination-origin)*t.projectileSpeed;
                    p.target=u.target; p.damage=t.damage; p.team=Team(u); p.alive=1; p.owner=i;
                    _Projectiles[slot]=p; fired=true; break;
                }
            } else { uint dealt=_BaseMode!=0?(uint)max(1,(float)t.damage-_Traits[Type(enemy)].armour*ArmourModifier(Team(enemy))*.5):t.damage;InterlockedAdd(_Damage[u.target],dealt);
                if(_BaseMode!=0&&_Traits[Type(u)].splash>0){int2 c=GridCoordinate(enemy.position);[loop]for(int y=-2;y<=2;y++)[loop]for(int x=-2;x<=2;x++){int2 q=WrapCell(c+int2(x,y),_GridRes);uint ci=q.x+q.y*_GridRes;[loop]for(uint n=0;n<min(24u,_ShotCounts[ci]);n++){uint at=_ShotIndices[_ShotOffsets[ci]+n];UnitState v=_Units[at];if(at!=u.target&&(v.flags&ALIVE)!=0&&Team(v)!=Team(u)&&WorldDistance(v.position,enemy.position,_WorldSize)<_Traits[Type(u)].splash)InterlockedAdd(_Damage[at],dealt/2);}}}fired=true; }
            if(fired&&_BaseMode!=0&&_WeaponNoise[Type(u)]>0&&_Traits[Type(u)].role!=8)EmitExplosionNoise(enemy.position,t.damage,_WeaponNoise[Type(u)]);
            if(fired && !IsZombie(u) && t.weapon!=1 && !(_BaseMode!=0 && _Traits[Type(u)].role==8))
                EmitShotTracer(WorldPosition(u)+float3(sin(u.turret)*2,1.3,cos(u.turret)*2),WorldPosition(enemy),Team(u),i+_Tick*103u,t.projectileSpeed);
            if(fired&&_BaseMode!=0){UnitOperations ops=_Operations[i];ops.ammo=max(0,ops.ammo-1);_Operations[i]=ops;}
            if(fired) u.cooldown=t.cooldown*(.9+ArmyRandom(i^_Tick)*.2)*(_BaseMode!=0&&FactionSupport(u)&&(_SupportInfluence[Team(u)*_GridRes*_GridRes+GridCell(u.position)]&4)!=0?.85:1);
        }
    } else u.turret=Turn(u.turret,u.facing,t.turnSpeed*_Delta);
    _Units[i]=u;
}
float SegmentDistanceSquared(float3 a,float3 b,float3 p) {
    float3 ab=b-a; float f=saturate(dot(p-a,ab)/max(dot(ab,ab),.0001));
    float3 d=a+ab*f-p; return dot(d,d);
}
[numthreads(128,1,1)]
void MoveProjectiles(uint3 id:SV_DispatchThreadID) {
    uint i=id.x; if(i>=_ProjectileCapacity) return;
    ProjectileState p=_Projectiles[i]; if(p.alive==0) return;
    float3 previous=p.position; p.position+=p.velocity*_Delta; p.lifetime-=_Delta;
    if(p.owner==INVALID) { // Cosmetic tracer: the firing kernel already resolved damage.
        if(p.lifetime<=0){p.position=previous+p.velocity*min(_Delta,max(0,p.lifetime+_Delta));EmitCombatVisual(p.position,1,0,p.team,i+_Tick*7919u,0);p.alive=0;}
        p.position.xz=WrapPosition(p.position.xz,_WorldSize);_Projectiles[i]=p;return;
    }
    uint hit=INVALID; float nearest=INF;
    if(_UseGrid!=0) {
        int2 centre=GridCoordinate(p.position.xz); uint examined=0;
        [loop] for(int y=-1;y<=1;y++) [loop] for(int x=-1;x<=1;x++) {
            int2 cell=WrapCell(centre+int2(x,y),_GridRes);
            uint ci=cell.x+cell.y*_GridRes, count=_ProjectileCellCounts[ci];
            [loop] for(uint j=0;j<min(count,16u) && examined<96;j++,examined++) {
                uint other=_ProjectileIndices[_ProjectileCellOffsets[ci]+j]; UnitState u=_Read[other];
                if((u.flags&ALIVE)==0 || Team(u)==p.team) continue;
                float3 target=NearestWorld(WorldPosition(u),previous,_WorldSize); float r=_Types[Type(u)].radius*1.5;
                float d2=SegmentDistanceSquared(previous,p.position,target);
                float travel=dot(target-previous,target-previous);
                if(d2<r*r && travel<nearest) { hit=other; nearest=travel; }
            }
        }
    }
    // Always test the intended victim even if the dense-cell sample budget was exhausted.
    if(p.target<_Active) {
        UnitState u=_Read[p.target]; float3 q=NearestWorld(WorldPosition(u),previous,_WorldSize);
        if((u.flags&ALIVE)!=0 && Team(u)!=p.team && SegmentDistanceSquared(previous,p.position,q)<4 && dot(q-previous,q-previous)<nearest) hit=p.target;
    }
    if(hit!=INVALID) { InterlockedAdd(_Damage[hit],p.damage);EmitCombatVisual(p.position,max(1,sqrt((float)p.damage)*.2),0,p.team,i+_Tick*7919u,0);EmitExplosionNoise(_Read[hit].position,p.damage,max(1,sqrt((float)p.damage)*.2));p.alive=0; }
    if(p.alive!=0&&(p.lifetime<=0 || p.position.y<Ground(p.position.xz).x)){EmitCombatVisual(p.position,max(1,sqrt((float)p.damage)*.2),0,p.team,i+_Tick*7919u,0);EmitExplosionNoise(p.position.xz,p.damage,max(1,sqrt((float)p.damage)*.2));p.alive=0;}
    p.position.xz=WrapPosition(p.position.xz,_WorldSize);_Projectiles[i]=p;
}
[numthreads(128,1,1)]
void ApplyDamage(uint3 id:SV_DispatchThreadID) {
    uint i=id.x; if(i>=_Active) return;
    UnitState u=_Units[i]; uint damage=_Damage[i]; _Damage[i]=0;
    if((u.flags&ALIVE)==0) return;
    u.health=damage>=u.health?0:u.health-damage;
    if(u.health==0) { EmitCombatDeath(u,i+_Tick*7919u);if(_BaseMode!=0){_ControlGroups[i]=0;uint slot;InterlockedAdd(_FreeCount[0],1,slot);if(slot<_Capacity)_FreeSlots[slot]=i;}u.flags=0; u.velocity=0; u.target=INVALID; u.group=INVALID; }
    _Units[i]=u;
}
[numthreads(128,1,1)]
void ClearStatistics(uint3 id:SV_DispatchThreadID) { if(id.x<128) _Statistics[id.x]=0; }
[numthreads(128,1,1)]
void UpdateStatistics(uint3 id:SV_DispatchThreadID) {
    uint i=id.x;
    if(i<_Active) {
        UnitState u=_Units[i];
        if((u.flags&ALIVE)!=0) {
#ifdef ZOMBIES
            InterlockedAdd(_Statistics[Team(u)<2?Team(u):112],1);
            if((u.flags&SWARM_UNIT)!=0)InterlockedAdd(_Statistics[113],1);
#else
            InterlockedAdd(_Statistics[Team(u)],1);
#endif
            if((u.flags&SELECTED)!=0) {InterlockedAdd(_Statistics[2],1);if(_BaseMode!=0&&_Traits[Type(u)].role==1)InterlockedAdd(_Statistics[80],1);}
            if(_BaseMode!=0&&_Traits[Type(u)].role==4)InterlockedAdd(_Statistics[88+Team(u)],1);
            if(u.target<_Active) InterlockedAdd(_Statistics[3],1);
            if(u.group<GROUP_COUNT) InterlockedAdd(_Statistics[16+u.group],1);
            if(_Spectator!=0 && Team(u)<2 && _Types[Type(u)].movement<3) {
                uint group=2+Team(u)*5+_Types[Type(u)].movement;GroupOrder g=_Groups[group];
                if(g.sequence!=0 && (u.packed>>16)==(g.sequence&65535u)) {
                    InterlockedAdd(_Statistics[116+Team(u)],1);
                    if(WorldDistance(u.position,g.destination,_WorldSize)<96)InterlockedAdd(_Statistics[114+Team(u)],1);
                }
            }
            else if(_BaseEnemyAI!=0 && Team(u)==1 && _Types[Type(u)].movement<3) {
                InterlockedAdd(_Statistics[117],1);
                if(WorldDistance(u.position,u.destination,_WorldSize)<96)InterlockedAdd(_Statistics[115],1);
            }
            uint2 sector=(uint2)(WorldUV(u.position,_WorldSize)*4);
            #ifdef ZOMBIES
            if(Team(u)<2)
#endif
            InterlockedAdd(_Statistics[48+Team(u)*16+sector.x+sector.y*4],1);
        }
    }
    if(i<_ProjectileCapacity && _Projectiles[i].alive!=0) InterlockedAdd(_Statistics[4],1);
    if(i<_GridRes*_GridRes) InterlockedMax(_Statistics[5],_CellCounts[i]);
}
[numthreads(128,1,1)]
void ClearVisibility(uint3 id:SV_DispatchThreadID) { if(id.x<5) _VisibleCounts[id.x]=0; }
bool InFrustum(float3 p,float radius) {
    [unroll] for(uint i=0;i<6;i++) if(dot(_Planes[i].xyz,p)+_Planes[i].w < -radius) return false;
    return true;
}
[numthreads(128,1,1)]
void ClassifyVisibility(uint3 id:SV_DispatchThreadID) {
    uint i=id.x; if(i>=_Active) return;
    UnitState u=_Units[i]; if((u.flags&ALIVE)==0) return;
    if((u.flags&32768)!=0)return;
    if(_Spectator==0 && _BaseMode!=0 && Team(u)!=0 && _Fog[IntelCell(u.position,0)]!=2)return;
    float3 p=NearestWorld(WorldPosition(u),_RenderFocus,_WorldSize); if(!InFrustum(p,4)) return;
    UnitArchetype t=_Types[Type(u)]; float d=distance(p,_CameraPosition);
    uint lod=_ProjectedUnitPixels>=0?(_ProjectedUnitPixels>=12?0:(_ProjectedUnitPixels>=4?1:2)):(d<t.nearDistance?0:(d<t.farDistance?1:2));
    if(_UseMeshes==0) lod=2;
    if(lod==2 && _UseImpostors==0) { if(_UseMeshes==0) return; lod=1; }
    uint slot; InterlockedAdd(_VisibleCounts[lod],1,slot);
    _Visible[lod*_Capacity+slot]=i;
}
[numthreads(128,1,1)]
void ClassifyProjectiles(uint3 id:SV_DispatchThreadID) {
    uint i=id.x; if(i>=_ProjectileCapacity || _UseVfx==0) return;
    ProjectileState p=_Projectiles[i];
    if(p.alive!=0 && InFrustum(NearestWorld(p.position,_RenderFocus,_WorldSize),4) && (_Spectator!=0||_BaseMode==0||p.team==0||_Fog[IntelCell(p.position.xz,0)]==2)) {
        uint slot; InterlockedAdd(_VisibleCounts[3],1,slot); _VisibleProjectiles[slot]=i;
    }
}
[numthreads(1,1,1)]
void BuildIndirectArgs(uint3 id:SV_DispatchThreadID) {
    uint indices[4]={_IndexCount0,_IndexCount1,_IndexCount2,_IndexCount3};
    [unroll] for(uint i=0;i<4;i++) {
        _Args[i*5]=indices[i]; _Args[i*5+1]=_VisibleCounts[i];
        _Args[i*5+2]=0; _Args[i*5+3]=0; _Args[i*5+4]=0;
        _Statistics[8+i]=_VisibleCounts[i];
    }
}
[numthreads(128,1,1)]
void ValidateGrid(uint3 id:SV_DispatchThreadID) {
    uint cell=id.x; if(cell>=_GridRes*_GridRes) return;
    uint count=_CellCounts[cell], offset=_CellOffsets[cell];
    if(_CellCursor[cell]!=count || offset+count>_Active) { InterlockedAdd(_Statistics[100],1);InterlockedAdd(_Statistics[107],1); return; }
    if(cell>0 && offset!=_CellOffsets[cell-1]+_CellCounts[cell-1]) { InterlockedAdd(_Statistics[100],1);InterlockedAdd(_Statistics[108],1); }
    [loop] for(uint j=0;j<count;j++) {
        uint unit=_Indices[offset+j];
        if(unit>=_Active) { InterlockedAdd(_Statistics[100],1); continue; }
        UnitState u=_Units[unit];
        if((u.flags&ALIVE)==0 || GridCell(u.position)!=cell) { InterlockedAdd(_Statistics[100],1);InterlockedAdd(_Statistics[109],1); }
        InterlockedAdd(_Damage[unit],1);
    }
    InterlockedAdd(_Statistics[101],count);
}
[numthreads(128,1,1)]
void ValidateMembership(uint3 id:SV_DispatchThreadID) {
    uint i=id.x; if(i>=_Active) return;
    uint expected=(_Units[i].flags&ALIVE)!=0?1:0;
    if(_Damage[i]!=expected) { InterlockedAdd(_Statistics[100],1);InterlockedAdd(_Statistics[110],1); }
    _Damage[i]=0;
}

