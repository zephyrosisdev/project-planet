            if(length(route)>.01&&ClearTerrainSegment(u.position,guided,t.movement)){proposed=guided;u.velocity=(proposed-u.position)/dt;}
            else if(ClearTerrainSegment(u.position,slideX,t.movement)&&abs(slideX.x-u.position.x)>.001){proposed=slideX;u.velocity.y=0;}
