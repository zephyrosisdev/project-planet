int2 GridCoordinate(float2 p) { return (int2)(WorldUV(p,_WorldSize)*_GridRes); }
uint GridCell(float2 p) { int2 c=GridCoordinate(p); return c.x+c.y*_GridRes; }
bool CellValid(int2 c) { return true; }
float3 WorldPosition(UnitState u) {float h=Ground(u.position).x;if(_BaseMode!=0&&_Traits[Type(u)].scale.w==4)h=max(h,_WaterMap.Load(int3((int2)(WorldUV(u.position,_WorldSize)*_NavRes),0)).x);return float3(u.position.x,h+1+(_BaseMode!=0?((u.flags&8192)!=0?0:_Traits[Type(u)].altitude):0),u.position.y); }
[numthreads(128,1,1)]
void InitializeUnits(uint3 id:SV_DispatchThreadID) {
    uint i=id.x; if(i>=_Active) return;
    if(_BaseMode!=0){_Units[i]=(UnitState)0;_Next[i]=(UnitState)0;_Damage[i]=0;_RouteProgress[i]=float2(INF,0);return;}
    uint team=i>=(_Active+1)/2, local=team!=0?i-(_Active+1)/2:i;
    float2 p=_SpawnSlots[i];
    _RouteProgress[i]=float2(INF,0);
    UnitState u=(UnitState)0;
    uint oppositeCount=team!=0?(_Active+1)/2:_Active/2,oppositeStart=team!=0?0:(_Active+1)/2;
    u.position=p; u.previous=p; u.destination=local<oppositeCount?_SpawnSlots[oppositeStart+local]:p;
    float2 heading=WorldDelta(p,u.destination,_WorldSize);u.facing=atan2(heading.x,heading.y); u.turret=u.facing;
    u.cooldown=ArmyRandom(i+_Seed)*1.8; u.health=_Types[0].health;
    u.packed=team|((_Groups[team].sequence&65535u)<<16); u.flags=ALIVE|ATTACK_MOVE|FORMATION; u.target=INVALID; u.group=team;
    _Units[i]=u; _Next[i]=u; _Damage[i]=0;
}
[numthreads(128,1,1)]
void InitializeProjectiles(uint3 id:SV_DispatchThreadID) {
    if(id.x<_ProjectileCapacity) _Projectiles[id.x]=(ProjectileState)0;
}
[numthreads(128,1,1)]
void ClearGrid(uint3 id:SV_DispatchThreadID) {
    if(id.x>=_GridRes*_GridRes) return;
    _CellCounts[id.x]=0; _CellCursor[id.x]=0;
}
[numthreads(128,1,1)]
void CountCells(uint3 id:SV_DispatchThreadID) {
    if(id.x>=_Active) return;
    UnitState u=_Units[id.x];
    if((u.flags&(ALIVE|32768))==ALIVE) InterlockedAdd(_CellCounts[GridCell(u.position)],1);
}
[numthreads(128,1,1)]
void ScatterUnits(uint3 id:SV_DispatchThreadID) {
    if(id.x>=_Active) return;
    UnitState u=_Units[id.x]; if((u.flags&(ALIVE|32768))!=ALIVE) return;
    uint cell=GridCell(u.position), slot;
    InterlockedAdd(_CellCursor[cell],1,slot);
    _Indices[_CellOffsets[cell]+slot]=id.x;
}
int2 ContactCoordinate(float2 p) { return (int2)(WorldUV(p,_WorldSize)*_ContactRes); }
uint ContactCell(float2 p) { int2 c=ContactCoordinate(p);return c.x+c.y*_ContactRes; }
[numthreads(128,1,1)]
void ClearContactGrid(uint3 id:SV_DispatchThreadID) {
    if(id.x>=_ContactRes*_ContactRes)return;_ContactCounts[id.x]=0;_ContactCursor[id.x]=0;
}
[numthreads(128,1,1)]
void CountContactCells(uint3 id:SV_DispatchThreadID) {
    if(id.x<_Active && (_Units[id.x].flags&(ALIVE|32768))==ALIVE)InterlockedAdd(_ContactCounts[ContactCell(_Units[id.x].position)],1);
}
[numthreads(128,1,1)]
void ScatterContactUnits(uint3 id:SV_DispatchThreadID) {
    if(id.x>=_Active)return;UnitState u=_Units[id.x];if((u.flags&(ALIVE|32768))!=ALIVE)return;
    uint cell=ContactCell(u.position),slot;InterlockedAdd(_ContactCursor[cell],1,slot);_ContactIndices[_ContactOffsets[cell]+slot]=id.x;
}
[numthreads(128,1,1)]
void SelectedFlags(uint3 id:SV_DispatchThreadID) {
    if(id.x<_Active) { UnitState u=_Units[id.x];_SelectedFlags[id.x]=Team(u)==0 && (u.flags&(ALIVE|SELECTED|32768))==(ALIVE|SELECTED)&&OrderMatches(u)?1:0; }
}
[numthreads(128,1,1)]
void ClearOrderOccupancy(uint3 id:SV_DispatchThreadID) { if(id.x<GROUP_COUNT*2+7)_OrderOccupancy[id.x]=0; }
[numthreads(128,1,1)]
void CountOrderOccupancy(uint3 id:SV_DispatchThreadID) {
    if(id.x>=_Active)return;UnitState u=_Units[id.x];if((u.flags&ALIVE)==0)return;
    bool selected=Team(u)==0 && (u.flags&(SELECTED|32768))==SELECTED && OrderMatches(u);
    if(u.group<GROUP_COUNT) {
        InterlockedAdd(_OrderOccupancy[u.group],1);
        if(selected)InterlockedAdd(_OrderOccupancy[GROUP_COUNT+u.group],1);
    }
    if(selected) {
        InterlockedAdd(_OrderOccupancy[GROUP_COUNT*2],1);
        InterlockedAdd(_OrderOccupancy[GROUP_COUNT*2+1+min(_Types[Type(u)].movement,4u)],1);
        InterlockedMax(_OrderOccupancy[GROUP_COUNT*2+6],asuint(_Types[Type(u)].radius));
    }
}
float2 CandidateSlot(uint index,GroupOrder g,out uint row) {
    uint columns=max(1u,g.columns);
    if(_SlotBatch==0) { row=index/columns;return FormationSlot(index,g); }
    uint rank=((g.count+columns-1)/columns)*columns+(_SlotBatch-1)*g.count+index;
    row=rank/columns;
    return g.destination+g.right*((float)(rank%columns)-((float)columns-1)*.5)*g.spacing-float2(-g.right.y,g.right.x)*row*g.spacing;
}
[numthreads(1,1,1)]
void ClearFormationSlots(uint3 id:SV_DispatchThreadID) {
    _FormationState[0]=0;_FormationState[1]=0;_FormationState[2]=_Groups[_CommandGroup].count;_FormationState[3]=0;
}
[numthreads(128,1,1)]
void FlagFormationSlots(uint3 id:SV_DispatchThreadID) {
    if(id.x>=_Active)return;GroupOrder g=_Groups[_CommandGroup];
    SetTraversalTeam(g.team);
    if(id.x>=g.count || g.padding!=0) { _SelectedFlags[id.x]=0;return; }
    uint row;float2 p=CandidateSlot(id.x,g,row);
    _SelectedFlags[id.x]=id.x<g.count && g.padding==0 && SafeTerrainPosition(p,g.movement)?1:0;
}
[numthreads(128,1,1)]
void ScatterFormationSlots(uint3 id:SV_DispatchThreadID) {
    if(id.x>=_Active || _SelectedFlags[id.x]==0)return;GroupOrder g=_Groups[_CommandGroup];
    uint rank=_FormationState[0]+_SelectedRanks[id.x];if(rank>=g.count)return;
    uint row;_FormationSlots[rank]=WrapPosition(CandidateSlot(id.x,g,row),_WorldSize);InterlockedMax(_FormationState[1],row+1);
}
[numthreads(1,1,1)]
void AdvanceFormationSlots(uint3 id:SV_DispatchThreadID) {
    _FormationState[0]=min(_FormationState[2],_FormationState[0]+_SelectedRanks[_Active-1]+_SelectedFlags[_Active-1]);
}
[numthreads(1,1,1)]
void FinishFormationSlots(uint3 id:SV_DispatchThreadID) {
    GroupOrder g=_Groups[_CommandGroup];if(g.padding==0 && _FormationState[0]<g.count)g.padding=2;
    SetTraversalTeam(g.team);
    g.localOrigin=TraversableSlot(g.destination-float2(-g.right.y,g.right.x)*max(0,(int)_FormationState[1]-1)*g.spacing*.5,g.movement);
    _Groups[_CommandGroup]=g;
}
[numthreads(1,1,1)]
void CommitFormation(uint3 id:SV_DispatchThreadID) {
    GroupOrder g=_Groups[GROUP_COUNT];g.sequence=_Groups[_CommandGroup].sequence;
    SetTraversalTeam(g.team);
    if(_CombinedFormation!=0&&_FilterMovement>=0){g.movement=(uint)_FilterMovement;g.destination+=_FormationOrigins[_FilterMovement].xy;g.localOrigin=TraversableSlot(g.localOrigin+_FormationOrigins[_FilterMovement].xy,g.movement);}
    _Groups[_CommandGroup]=g;
}
[numthreads(128,1,1)]
void MixedFormationSlots(uint3 id:SV_DispatchThreadID) {
    uint i=id.x;if(i>=_Active)return;UnitState u=_Units[i];if(Team(u)!=0||(u.flags&(ALIVE|SELECTED|32768))!=(ALIVE|SELECTED))return;
    uint rank=_CombinedRanks[i],movement=_Types[Type(u)].movement;GroupOrder g=_Groups[_CommandGroup];
    float2 origin=_FormationOrigins[movement].xy,p=FormationSlot(rank,g)+origin;uint row=rank/max(1u,g.columns);bool valid=false;
    if(g.padding==0){[unroll]for(uint attempt=0;attempt<4;attempt++){
        uint candidate=attempt==0?rank:((g.count+g.columns-1)/g.columns)*g.columns+(attempt-1)*g.count+rank;
        row=candidate/max(1u,g.columns);
        p=attempt==0?FormationSlot(rank,g)+origin:g.destination+origin+g.right*((float)(candidate%g.columns)-((float)g.columns-1)*.5)*g.spacing-float2(-g.right.y,g.right.x)*row*g.spacing;
        if(SafeTerrainPosition(p,movement)){valid=true;break;}
    }}
    _FormationSlots[rank]=WrapPosition(p,_WorldSize);_SelectedFlags[rank]=valid?1u:0u;
    if(valid){InterlockedAdd(_FormationState[0],1);InterlockedMax(_FormationState[1],row+1);}
}
[numthreads(128,1,1)]
void ApplyStrategicSlots(uint3 id:SV_DispatchThreadID) {
    if(id.x>=_Active)return;UnitState u=_Units[id.x];GroupOrder g=_Groups[1];
    if(u.group!=1 || (u.flags&ALIVE)==0 || g.padding!=0)return;
    u.destination=_FormationSlots[id.x-(_Active+1)/2];
    u.flags&=~(DIRECT_ROUTE|DETOUR_ROUTE|ROUTE_TRACKED|ARRIVED|FORMATION_ENTRY|PASS_RIGHT|PASS_LEFT);
    u.packed=(u.packed&65535u)|((g.sequence&65535u)<<16);_Units[id.x]=u;
}
[numthreads(128,1,1)]
void AssignFactionOrders(uint3 id:SV_DispatchThreadID){
    uint i=id.x;if(i>=_Active)return;UnitState u=_Units[i];if((u.flags&(ALIVE|32768|8192))!=ALIVE||Team(u)!=_FactionTeam)return;
    uint movement=_Types[Type(u)].movement,group=2+_FactionTeam*5+movement;GroupOrder g=_Groups[group];if(g.sequence==0)return;
    // Replenishments join the existing order; arrived troops keep their slots.
    if((u.packed>>16)==(g.sequence&65535u))return;
    SetTraversalTeam(_FactionTeam);float angle=ArmyRandom(i*73u+group)*6.2831853;float radius=8+ArmyRandom(i*113u+group)*24;
    u.destination=TraversableSlot(g.destination+float2(sin(angle),cos(angle))*radius,movement);u.group=group;
    u.flags=(u.flags&~(STOPPED|DIRECT_ROUTE|DETOUR_ROUTE|ROUTE_TRACKED|ARRIVED|FORMATION_ENTRY|PASS_RIGHT|PASS_LEFT))|ATTACK_MOVE;u.target=INVALID;
    u.packed=(u.packed&65535u)|((g.sequence&65535u)<<16);_Units[i]=u;
}
[numthreads(128,1,1)]
void AssignClearanceOrders(uint3 id:SV_DispatchThreadID){
    uint i=id.x;if(i>=_Active)return;UnitState u=_Units[i];if((u.flags&(ALIVE|32768|8192))!=ALIVE||Team(u)!=1)return;
    uint movement=_Types[Type(u)].movement;if(movement>=3)return;GroupOrder g=_Groups[1];if(g.sequence==0||(u.packed>>16)==(g.sequence&65535u)&&u.group==1)return;
    if((u.packed>>16)==(g.sequence&65535u)&&(u.flags&ARRIVED)!=0)return;
    SetTraversalTeam(1);float angle=ArmyRandom(i*73u+1)*6.2831853;float radius=8+ArmyRandom(i*113u+1)*24;
    u.destination=TraversableSlot(g.destination+float2(sin(angle),cos(angle))*radius,movement);u.group=1;
    u.flags=(u.flags&~(STOPPED|DIRECT_ROUTE|DETOUR_ROUTE|ROUTE_TRACKED|ARRIVED|FORMATION_ENTRY|PASS_RIGHT|PASS_LEFT))|ATTACK_MOVE;u.target=INVALID;u.packed=(u.packed&65535u)|((g.sequence&65535u)<<16);_Units[i]=u;
}
[numthreads(1,1,1)]
void FinalizeFormation(uint3 id:SV_DispatchThreadID) {
    GroupOrder g=_Groups[_CommandGroup];g.count=_SelectedRanks[_Active-1]+_SelectedFlags[_Active-1];
    SetTraversalTeam(g.team);
    g.columns=clamp((uint)floor(g.width/g.spacing+.0001)+1,1,max(1u,g.count));
    uint rows=(g.count+g.columns-1)/g.columns;
    float2 halfFront=g.right*(g.columns-1)*g.spacing*.5;
    float2 rear=g.destination-float2(-g.right.y,g.right.x)*max(0,(int)rows-1)*g.spacing;
    float bound=_WorldSize*.5-4;
    g.padding=length(float2(length(halfFront)*2,(rows-1)*g.spacing))>=_WorldSize-g.spacing?1:0;
    g.localOrigin=TraversableSlot(g.destination-float2(-g.right.y,g.right.x)*max(0,(int)rows-1)*g.spacing*.5,g.movement);
    _Groups[_CommandGroup]=g;
    _PreviewArgs[0]=6;_PreviewArgs[1]=min(g.count,4096u);_PreviewArgs[2]=0;_PreviewArgs[3]=0;_PreviewArgs[4]=0;
}
[numthreads(128,1,1)]
void PreviewFormationSlots(uint3 id:SV_DispatchThreadID) {
    GroupOrder g=_Groups[_CommandGroup];uint n=min(g.count,4096u);if(id.x>=n)return;
    uint rank=id.x*g.count/n;float2 p=rank<_FormationState[0]?_FormationSlots[rank]:FormationSlot(rank,g);
    if(_CombinedFormation!=0)p=_FormationSlots[rank];
    _PreviewSlots[id.x]=float4(p,_CombinedFormation!=0?(_SelectedFlags[rank]==0?1:0):(g.padding!=0 || rank>=_FormationState[0]?1:0),rank);
}
bool Parking(UnitState u) { return (u.flags&FORMATION)!=0 && WorldDistance(u.position,u.destination,_WorldSize)<7; }
bool IgnoreFriendly(UnitState u,UnitState other) {
    if(Team(u)!=Team(other))return false;
    // A stalled incoming tank may enter a filled formation through already parked friendlies.
    // Ordinary moving traffic and manually stopped tanks retain full avoidance and contact.
    if((u.flags&FORMATION_ENTRY)!=0 && (other.flags&ARRIVED)!=0 && Parking(other))return true;
    return Parking(u) && ((u.flags&ARRIVED)==0 || Parking(other) || (other.flags&(STOPPED|ARRIVED|FORMATION_ENTRY))!=0);
}
float GlobalValue(uint group,int2 c) {
    c=WrapCell(c,_NavRes);
    return _GlobalField[group*_NavRes*_NavRes+c.x+c.y*_NavRes];
}
float2 FlowDirection(inout UnitState u,uint id,uint movement,out float2 route) {
    route=0;
#ifdef SWARM_MODE
    if((u.flags&ZOMBIE_UNIT)!=0){
        if((u.flags&ZOMBIE_WANDERING)!=0)return SafeNormal(WorldDelta(u.position,u.destination,_WorldSize));
        if((u.flags&DIRECT_ROUTE)==0||(id+_Tick)%16==0){if(ClearTerrainSegment(u.position,u.destination,movement))u.flags|=DIRECT_ROUTE;else u.flags&=~DIRECT_ROUTE;}
        if((u.flags&DIRECT_ROUTE)!=0)return SafeNormal(WorldDelta(u.position,u.destination,_WorldSize));
        int2 c=(int2)floor((u.position/_WorldSize+.5)*_NavRes);uint offset=movement*_NavRes*_NavRes;
        int2 wrapped=WrapCell(c,_NavRes);float best=_SwarmField[offset+wrapped.x+wrapped.y*_NavRes].x;float2 waypoint=u.position;
        float4 hearing=_NoiseField[wrapped.x+wrapped.y*_NavRes];bool investigating=_Operations[id].timer>_Tick/30.0&&WorldDistance(_Operations[id].mission,u.destination,_WorldSize)<4;bool noise=investigating&&hearing.w>_Tick/30.0&&WorldDistance(NoisePosition(hearing.x,_WorldSize),u.destination,_WorldSize)<4;
        if(investigating&&!noise)return SafeNormal(WorldDelta(u.position,u.destination,_WorldSize));
        float loud=hearing.z;
        [unroll]for(int y=-1;y<=1;y++)[unroll]for(int x=-1;x<=1;x++){
            if(x==0&&y==0)continue;int2 q=WrapCell(c+int2(x,y),_NavRes);float value=_SwarmField[offset+q.x+q.y*_NavRes].x;
            float4 sound=_NoiseField[q.x+q.y*_NavRes];bool improves=noise?sound.w>_Tick/30.0&&asuint(sound.x)==asuint(hearing.x)&&sound.z>loud:value<best;
            if(improves&&CellCost(q,movement)<INF*.5&&(x==0||y==0||(CellCost(c+int2(x,0),movement)<INF*.5&&CellCost(c+int2(0,y),movement)<INF*.5))){best=value;loud=sound.z;waypoint=CellWorld(q);}
        }
        route=SafeNormal(WorldDelta(u.position,waypoint,_WorldSize));if(investigating&&length(route)<.01)return SafeNormal(WorldDelta(u.position,u.destination,_WorldSize));return route;
    }
#endif
    if(u.group>=GROUP_COUNT)return SafeNormal(WorldDelta(u.position,u.destination,_WorldSize));
    // Cache verified line-of-sight, but recheck after local steering or an obstacle slide.
    if((u.flags&DETOUR_ROUTE)==0 && ((u.flags&DIRECT_ROUTE)==0 || (id+_Tick)%16==0)) {
        if(ClearTerrainSegment(u.position,u.destination,movement))u.flags|=DIRECT_ROUTE;else u.flags&=~DIRECT_ROUTE;
    }
    if((u.flags&DIRECT_ROUTE)!=0)return SafeNormal(WorldDelta(u.position,u.destination,_WorldSize));
    u.flags|=DETOUR_ROUTE;
    int2 c=(int2)floor((u.position/_WorldSize+.5)*_NavRes);
    float current=GlobalValue(u.group,c),best=current;float2 waypoint=u.position;
    [unroll] for(int y=-1;y<=1;y++) [unroll] for(int x=-1;x<=1;x++) {
        if(x==0&&y==0)continue;int2 other=c+int2(x,y);float value=GlobalValue(u.group,other);
        if(value<best && (x==0||y==0||(CellCost(c+int2(x,0),movement)<INF*.5 && CellCost(c+int2(0,y),movement)<INF*.5))) {
            best=value;waypoint=CellWorld(other);
        }
    }
    // Preserve each tank's lane through the fine field. Shared coarse cell centres form traffic funnels.
    float cellSize=_WorldSize/_NavRes;
    if(best<current) {
        float2 lane=clamp(WorldDelta(CellWorld(c),u.position,_WorldSize),-cellSize*.5+2.3,cellSize*.5-2.3);
        float2 parallel=waypoint+lane;
        if(ClearTerrainSegment(u.position,parallel,movement))waypoint=parallel;
        float left=GlobalValue(u.group,c+int2(-1,0)),right=GlobalValue(u.group,c+int2(1,0));
        float down=GlobalValue(u.group,c+int2(0,-1)),up=GlobalValue(u.group,c+int2(0,1));
        if(max(max(left,right),max(down,up))<INF*.5) {
