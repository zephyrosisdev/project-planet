float4 CrowdSample(float2 p) {
    float2 grid=WorldUV(p,_WorldSize)*_CrowdRes-.5;
    int2 a=WrapCell((int2)floor(grid),_CrowdRes),b=WrapCell(a+1,_CrowdRes);float2 f=frac(grid);
