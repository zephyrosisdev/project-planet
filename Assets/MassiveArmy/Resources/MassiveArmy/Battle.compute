    bool useCrowd=_UseCrowd!=0&&(_BaseMode==0||t.movement<3);float4 crowd=0;if(useCrowd && !Parking(u))crowd=CrowdSample(u.position);
    if(_BaseMode!=0&&_Logistics!=0&&t.movement!=0&&_Operations[i].fuel<1)speedScale=.15;
    float2 queueNormal=0;float queueLower=0,queueViolation=0;
