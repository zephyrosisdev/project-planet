bool OrderMatches(UnitState u) {return _FilterMovement<0||_Types[Type(u)].movement==(uint)_FilterMovement;}
uint IntelCell(float2 p,uint team) {uint2 c=(uint2)(WorldUV(p,_WorldSize)*_FogRes);return team*_FogRes*_FogRes+c.x+c.y*_FogRes;}
bool TargetKnown(UnitState u,uint team) {
#ifdef ZOMBIES
if(team==ZOMBIE_TEAM)return true;
#endif
return _BaseMode==0||_Fog[IntelCell(u.position,team)]==2||(_Traits[Type(u)].signature>_Traits[Type(u)].stealth&&_Radar[IntelCell(u.position,team)]>0);}
bool TargetAllowed(UnitState u,UnitState enemy) {return (enemy.flags&32768)==0&&(_BaseMode==0||((_Traits[Type(u)].targetMask&(1u<<_Types[Type(enemy)].movement))!=0&&TargetKnown(enemy,Team(u))));}
