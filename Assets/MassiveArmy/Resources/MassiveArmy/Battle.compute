                    float2 traffic=SafeNormal(WorldDelta(v.position,v.destination,_WorldSize)),side=float2(traffic.y,-traffic.x);
                    float ahead=dot(delta,traffic),lateral=dot(delta,side);
                    // Parked tanks yield only when they actually obstruct incoming traffic.
                    // Reacting to every nearby mover makes an otherwise finished formation churn forever.
