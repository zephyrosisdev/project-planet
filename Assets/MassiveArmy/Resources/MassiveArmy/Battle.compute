        if(useCrowd){float2 gradient=crowd.zw,normal=SafeNormal(gradient);desired-=normal*max(0,dot(desired,normal))*saturate((crowd.x-.85)/.4);
            float2 pressure=-gradient*(.12/_Delta);desired+=SafeNormal(pressure)*min(length(pressure),t.speed*.8);desired=SafeNormal(desired)*min(length(desired),t.speed);}
