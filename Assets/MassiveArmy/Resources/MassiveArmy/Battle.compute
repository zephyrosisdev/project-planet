            float2 smooth=u.position+gradient*cellSize;
            int2 next=(int2)floor((smooth/_WorldSize+.5)*_NavRes);
            if(GlobalValue(u.group,next)<current && ClearTerrainSegment(u.position,smooth,movement))waypoint=smooth;
        }
    }
    if(best<INF*.5 && WorldDistance(waypoint,u.position,_WorldSize)>.05) {
        route=SafeNormal(WorldDelta(u.position,waypoint,_WorldSize));
        // Stay on the connected detour until it approaches the group goal. Fleeting sight of a slot
        // at a concave bank must not repeatedly switch steering back into the same obstacle.
        if(WorldDistance(u.position,_Groups[u.group].localOrigin,_WorldSize)<cellSize*2 ||
            (WorldDistance(u.position,u.destination,_WorldSize)<cellSize*4 && ClearTerrainSegment(u.position,u.destination,movement))) {
            if(ClearTerrainSegment(u.position,u.destination,movement)) { u.flags&=~DETOUR_ROUTE;u.flags|=DIRECT_ROUTE;return SafeNormal(WorldDelta(u.position,u.destination,_WorldSize)); }
        }
        return route;
    }
    if(current<INF*.5 && ClearTerrainSegment(u.position,u.destination,movement)) {
        u.flags&=~DETOUR_ROUTE;u.flags|=DIRECT_ROUTE;return SafeNormal(WorldDelta(u.position,u.destination,_WorldSize));
    }
