[numthreads(128,1,1)]
void ValidateSpawns(uint3 id:SV_DispatchThreadID) {
    uint i=id.x;if(i>=_Active)return;UnitState u=_Units[i];
    SetTraversalTeam(Team(u));
    InterlockedAdd(_Statistics[106],1);
    if(!SafeTerrainPosition(u.position,2))InterlockedAdd(_Statistics[104],1);
    int2 cell=ContactCoordinate(u.position);int rings=(int)ceil(5.2/(_WorldSize/_ContactRes));
    [loop] for(int y=-rings;y<=rings;y++) [loop] for(int x=-rings;x<=rings;x++) {
        int2 c=WrapCell(cell+int2(x,y),_ContactRes);
        uint ci=c.x+c.y*_ContactRes;
        [loop] for(uint j=0;j<_ContactCounts[ci];j++) {
            uint other=_ContactIndices[_ContactOffsets[ci]+j];
            if(other!=i && WorldDistance(u.position,_Units[other].position,_WorldSize)<5.18)InterlockedAdd(_Statistics[105],1);
        }
    }
