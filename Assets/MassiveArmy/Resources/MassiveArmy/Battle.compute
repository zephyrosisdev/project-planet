                float2 relative=direction*t.speed-v.velocity;
                float closest=clamp(-dot(delta,relative)/max(dot(relative,relative),.001),0,.35);
                if(d<radius+4 && dot(delta,relative)<0 && length(delta+relative*closest)<radius*1.15) {
                    // Right-hand passing is relative to travel direction, so opposing traffic chooses opposite world sides.
