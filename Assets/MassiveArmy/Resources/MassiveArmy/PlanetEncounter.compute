[numthreads(128,1,1)]void FindDormantValidation(uint3 id:SV_DispatchThreadID){if(id.x>=_Count)return;UnitState u=_Units[id.x];if((u.flags&(ALIVE|ZOMBIE_UNIT))==(ALIVE|ZOMBIE_UNIT)&&_UnitActivity[id.x]==0&&length(PlanetDecode(u.position)-_Home)*_PlanetRadius>_InterestRadius+500)InterlockedMin(_ActiveDispatch[4],id.x);}

// Event-only dispatch; no extra per-tick army scan for strategic weapons.
[numthreads(128,1,1)]void StrategicBlast(uint3 id:SV_DispatchThreadID){if(id.x>=_Count)return;UnitState u=_Units[id.x];if((u.flags&ALIVE)==0)return;float distance=length(PlanetDecode(u.position)-_StrategicBlast.xyz)*_PlanetRadius;if(distance<_StrategicRadius)_Damage[id.x]=(uint)max(1,_StrategicBlast.w*(1-distance/_StrategicRadius*.75));
 // Event-only exact destinations avoid coarse hearing-cell quantization, with no new per-tick unit work.
 if((u.flags&ZOMBIE_WANDERING)!=0&&distance<_StrategicHearingRadius&&StartingRefugeClear(_StrategicBlast.xyz)){u.destination=PlanetEncode(_StrategicBlast.xyz);u.flags&=~(ARRIVED|STOPPED);_Units[id.x]=u;}}
[numthreads(1,1,1)]void StrategicStamp(uint3 id:SV_DispatchThreadID){uint serial;InterlockedAdd(_RemainsCounter[0],1,serial);serial++;float3 up=_StrategicBlast.xyz;Remains stamp;stamp.centre=float4(up,_StrategicRadius*2);stamp.tangent=float4(normalize(cross(abs(up.y)>.95?float3(1,0,0):float3(0,1,0),up)),0);stamp.metadata=float4(0,0,0,serial);_Remains[(serial-1)%512]=stamp;int2 centre=PlanetPositionCell(PlanetEncode(up),_RemainsResolution);int extent=min(16,1+(int)ceil(_StrategicRadius/(2*_PlanetRadius/_RemainsResolution*.4)));for(int y=-extent;y<=extent;y++)for(int x=-extent;x<=extent;x++){int2 c=centre;for(int a=0;a<abs(x);a++)c=PlanetNeighbour(c,int2(x<0?-1:1,0),_RemainsResolution);for(int b=0;b<abs(y);b++)c=PlanetNeighbour(c,int2(0,y<0?-1:1),_RemainsResolution);InterlockedMax(_RemainsIndex[PlanetIndex(c,_RemainsResolution)],serial);}}

StructuredBuffer<uint> _PreviousStructureDamage;uint _OldStructureCapacity,_NewStructureCapacity;
[numthreads(128,1,1)]void GrowStructureDamage(uint3 id:SV_DispatchThreadID){if(id.x<_NewStructureCapacity)_StructureDamage[id.x]=id.x<_OldStructureCapacity?_PreviousStructureDamage[id.x]:0;}


// Each outdoor resident queries at most 192 army hash entries. A tick-stamped atomic
// claim gives one citizen exclusive control of a nearby zombie for this tick, without
// clearing a million claims or changing the full-army steering/fighting kernels.
[numthreads(128,1,1)]void CivicFindTargets(uint3 id:SV_DispatchThreadID){uint i=id.x;if(i>=_CivicCount)return;CivicAgent c=_CivicStates[i];c.flags&=~8u;c.cooldown=max(0,c.cooldown-_Dt);if(c.health==0||(c.flags&1u)==0){_CivicStates[i]=c;return;}
 float3 direction=normalize(c.body.xyz);int2 cell=SpatialCell(PlanetEncode(direction),0);uint examined=0;float best=35;uint target=INVALID;int rings=min(2,SpatialRings(60,0));
 for(int ring=SPARSE_SPATIAL!=0?0:1;ring<=rings;ring++)for(int edge=0;edge<(SPARSE_SPATIAL!=0?max(1,8*ring):9);edge++){int2 offset=SPARSE_SPATIAL!=0?SpatialRingOffset(ring,edge):int2(edge%3-1,edge/3-1);int2 neighbour=SpatialOffset(cell,offset.x,offset.y,0);uint p=_HeadsRead[SpatialIndex(neighbour,0)];
 for(uint k=0;k<32&&p!=INVALID&&examined<192;k++){uint other=p;UnitState snapshot=_SnapshotRead[p];p=_NextRead[p];examined++;if(Team(snapshot)!=2||(snapshot.flags&ALIVE)==0||!SpatialMatches(snapshot,neighbour,0))continue;float distance=PlanetArc(direction,PlanetDecode(snapshot.position),_PlanetRadius);if(distance<best){best=distance;target=other;}if(distance>=60)continue;
 uint stamp=_CivicClaims[other];if(stamp==_Tick+1)continue;UnitState u=_Units[other];UnitArchetype a=_Types[Type(u)];float3 d=PlanetDecode(u.position);float nearest=a.acquisitionRange;
 if(u.target!=INVALID){if((u.target&STRUCTURE_TARGET)!=0){float4 centre=_Structures[(u.target&~STRUCTURE_TARGET)*3];nearest=max(0,PlanetArc(d,centre.xyz,_PlanetRadius)-centre.w);}else if(u.target<_Count)nearest=PlanetArc(d,PlanetDecode(_SnapshotRead[u.target].position),_PlanetRadius);}
 if(distance>=min(a.acquisitionRange,nearest+12))continue;uint old;InterlockedCompareExchange(_CivicClaims[other],stamp,_Tick+1,old);if(old!=stamp)continue;
 u.target=INVALID;u.flags&=~(STOPPED|ARRIVED);float3 delta=direction-d*dot(direction,d);float3 desired=dot(delta,delta)>1e-10?normalize(delta)*a.speed:0;bool melee=distance<=a.attackRange+.5;
 if(melee){desired=0;if(u.cooldown<=_Dt){c.damage+=a.damage;u.cooldown=max(.033,a.cooldown)+_Dt;}}
 if(_CrowdEnabled!=0)desired=AvoidPlanetTraffic(u,other,desired);_Units[other]=u;_Steering[other]=float4(desired,melee?-1:3);
 }}
 if((c.flags&2u)!=0&&(c.pad&1u)!=0&&(c.pad>>1)<(c.flags>>16)&&target!=INVALID){c.flags|=8u;if(c.cooldown<=0){InterlockedAdd(_Damage[target],35u);c.pad+=2;c.cooldown=1;}}
 if(c.damage>0){c.health=c.damage>=c.health?0:c.health-c.damage;c.lastHitTick=_Tick;if(c.health==0){c.body.w=_CivicClock;if((c.flags&128u)!=0)c.flags|=512u|4u|((c.flags&8192u)==0?256u:0u);InterlockedAdd(_Counters[3],1u);}c.damage=0;}
 _CivicStates[i]=c;
}
[numthreads(128,1,1)]void InitialiseCivicClaims(uint3 id:SV_DispatchThreadID){if(id.x<_Capacity)_CivicClaims[id.x]=0;}
