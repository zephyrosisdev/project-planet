#pragma kernel PickHearse
#pragma kernel Navigate
#pragma kernel ClearSearch
#pragma kernel CopySearch
// A bounded, incremental reverse breadth-first search per cargo mission. Only uploaded
// same-owner road edges exist in this graph; terrain/army navigation is never sampled.
struct Node {float4 position;int4 neighbours;};
struct Job {float4 start,goal;uint version,startNode,goalNode,flags;float4 parameters;};
struct Work {uint version,head,tail,node;uint next,phase,arrived,pad;float progress,distance;uint searchEpoch,topology;uint searchSlot,routeLength,routeCursor,reserved;};
struct Summary {uint version,arrived;float distance;uint status;};
struct Pose {float4 position,right,up,forward,properties;};
StructuredBuffer<Node> _RoadNodes,_RailNodes;uint _RailCount;
Node RouteNode(uint index,uint flags){if((flags&16)!=0)return _RailNodes[index];return _RoadNodes[index];}
StructuredBuffer<Job> _RoadJobs;
RWStructuredBuffer<Work> _RoadWork;
struct SearchCell {uint epoch,parent,queue;float distance;};
RWStructuredBuffer<SearchCell> _RoadSearch;
RWStructuredBuffer<Summary> _RoadSummary;
RWStructuredBuffer<Pose> _CargoPoses;
uint _RoadCount,_RoadStride,_CargoCount,_RoadRevision;
float _CargoDelta,_RoadLaneOffset;float4 _RaiderCamps[8];uint _RaiderCampCount;
StructuredBuffer<Work> _PreviousWork;
StructuredBuffer<Pose> _PreviousPoses;
StructuredBuffer<uint> _PreviousRoutes;
RWStructuredBuffer<uint> _RoadRoutes;
RWStructuredBuffer<uint> _SearchOwners,_SearchEpochs;
uint _PreviousSlots,_SearchSlots,_StorageWidth,_RouteStride,_CargoDispatch;
[numthreads(128,1,1)]
void ClearSearch(uint3 id:SV_DispatchThreadID){uint index=id.x+id.y*_StorageWidth;
 if(index<_RoadStride*_SearchSlots)_RoadSearch[index].epoch=0;
 if(index<_SearchSlots){_SearchOwners[index]=0;_SearchEpochs[index]=0;}
 if(index<_CargoCount)_RoadWork[index]=(Work)0;
}
[numthreads(128,1,1)]
void CopySearch(uint3 id:SV_DispatchThreadID){uint index=id.x+id.y*_StorageWidth;
 if(index>=_PreviousSlots*_RouteStride)return;uint slot=index/_RouteStride;
 _RoadRoutes[index]=_PreviousRoutes[index];
 if(index%_RouteStride==0){Work w=_PreviousWork[slot];w.searchSlot=0xffffffffu;
  if(w.phase==0||w.phase==3){w.phase=0;w.head=w.tail=0;}w.topology=_RoadRevision;
  _RoadWork[slot]=w;_CargoPoses[slot]=_PreviousPoses[slot];}
}
// Stamp retired slots with this dispatch. They become reusable in a later
// dispatch, after Unity's UAV ordering, without a separate recycling pass.
void ReleaseSearch(inout Work w,uint slot){
 if(w.searchSlot<_SearchSlots){uint ignored;InterlockedCompareExchange(_SearchOwners[w.searchSlot],slot+1,0x80000000u|_CargoDispatch,ignored);}w.searchSlot=0xffffffffu;
}
bool AcquireSearch(inout Work w,uint slot,Job job,uint routeCount){
 if(w.node>=routeCount||job.goalNode>=routeCount){w.phase=3;ReleaseSearch(w,slot);return false;}
 if(w.searchSlot<_SearchSlots){if(_SearchOwners[w.searchSlot]==slot+1)return true;}
 w.searchSlot=0xffffffffu;
 // Rotate at most two probes per waiting job. Scanning every occupied slot
 // makes a queued fleet contend on the same atomics even though no slot is free.
 uint first=(slot+w.reserved++)%_SearchSlots;
 for(uint i=0;i<min(2u,_SearchSlots);i++){uint pool=(first+i)%_SearchSlots,available=_SearchOwners[pool],owner;
  if(available!=0){if((available&0x80000000u)==0||(available&0x7fffffffu)==_CargoDispatch)continue;}
  InterlockedCompareExchange(_SearchOwners[pool],available,slot+1,owner);
  if(owner!=available)continue;w.searchSlot=pool;InterlockedAdd(_SearchEpochs[pool],1,w.searchEpoch);w.searchEpoch++;
  uint baseIndex=pool*_RoadStride,goal=baseIndex+job.goalNode;w.head=0;w.tail=1;
  _RoadSearch[goal].epoch=w.searchEpoch;_RoadSearch[goal].parent=job.goalNode;_RoadSearch[goal].distance=0;_RoadSearch[baseIndex].queue=job.goalNode;return true;
 }return false;
}
uint RouteNext(uint slot,Work w,uint ahead){return _RoadRoutes[slot*_RouteStride+min(w.routeCursor+ahead,max(1u,w.routeLength)-1)];}
// Bevelled lane joins use the same route parents as the centreline search.
float3 LaneRight(float3 direction,float3 up){direction-=up*dot(up,direction);return normalize(cross(up,normalize(direction)));}
float3 LaneJoin(float3 a,float3 b){float3 sum=a+b;float lengthSum=length(sum);if(lengthSum<.001)return b*_RoadLaneOffset;float3 m=sum/lengthSum;return m*(_RoadLaneOffset/max(.7071,dot(m,b)));}
[numthreads(32,1,1)]
void Navigate(uint slot:SV_DispatchThreadID){
 if(slot>=_CargoCount)return;
 Job job=_RoadJobs[slot];if(job.version==0||(job.flags&128u)!=0){Work retired=_RoadWork[slot];ReleaseSearch(retired,slot);retired.version=job.version;retired.phase=2;retired.arrived=1;_RoadWork[slot]=retired;_RoadSummary[slot]=(Summary)0;_CargoPoses[slot]=(Pose)0;return;}uint routeCount=(job.flags&16)!=0?_RailCount:_RoadCount;Work w=_RoadWork[slot];uint baseIndex=0;
 // Completed jobs already published their final pose and event. Preserve them
 // until a mission/topology change; parking with arrived==0 still advances.
 if(w.version==job.version&&w.phase==2&&w.arrived!=0&&w.topology==_RoadRevision)return;
 if(w.version!=job.version){
  uint previousVersion=w.version;ReleaseSearch(w,slot);w=(Work)0;w.searchSlot=0xffffffffu;w.pad=previousVersion!=0?1:0;w.version=job.version;w.topology=_RoadRevision;w.node=job.startNode;
  if((job.flags&4)!=0){w.phase=2;w.arrived=1;}
  else if((job.flags&10)!=0)w.phase=1;
  else if(job.startNode>=routeCount||job.goalNode>=routeCount)w.phase=3;
  else if((uint)RouteNode(job.startNode,job.flags).position.w!=(uint)job.parameters.y||(uint)RouteNode(job.goalNode,job.flags).position.w!=(uint)job.parameters.y)w.phase=3;
  else {w.phase=0;}
 }
 // Completed/moving missions keep their GPU position across topology changes. Failed
 // or pending searches retry from their unmoved start with a fresh per-slot epoch.
 if(w.topology!=_RoadRevision){w.topology=_RoadRevision;if((job.flags&14)==0&&(w.phase==0||w.phase==3)&&w.node<routeCount&&job.goalNode<routeCount){
  ReleaseSearch(w,slot);w.head=w.tail=0;w.phase=0;w.arrived=0;
 }}
 // HLSL logical operators do not short-circuit side effects. Only waiting
 // missions may acquire scratch; completed/moving jobs must never hold it.
 if(w.phase==0){if(AcquireSearch(w,slot,job,routeCount)){
  baseIndex=w.searchSlot*_RoadStride;
  for(uint budget=0;budget<128&&w.head<w.tail;budget++){
   uint node=_RoadSearch[baseIndex+w.head++].queue;
   if(node==w.node){
    w.distance=max(w.distance,_RoadSearch[baseIndex+node].distance);w.routeLength=1;w.routeCursor=0;_RoadRoutes[slot*_RouteStride]=node;
    uint at=node;for(uint step=1;step<_RouteStride&&at!=job.goalNode;step++){uint next=_RoadSearch[baseIndex+at].parent;if(next>=routeCount||next==at)break;_RoadRoutes[slot*_RouteStride+step]=next;w.routeLength++;at=next;}
    w.next=RouteNext(slot,w,1);w.phase=1;ReleaseSearch(w,slot);break;
   }
   Node road=RouteNode(node,job.flags);
   for(uint edge=0;edge<4;edge++){
    int adjacent=road.neighbours[edge];if(adjacent<0)continue;uint index=baseIndex+(uint)adjacent;
    if(_RoadSearch[index].epoch==w.searchEpoch)continue;
    _RoadSearch[index].epoch=w.searchEpoch;_RoadSearch[index].parent=node;
    _RoadSearch[index].distance=_RoadSearch[baseIndex+node].distance+length(RouteNode(adjacent,job.flags).position.xyz-road.position.xyz);
    _RoadSearch[baseIndex+w.tail++].queue=(uint)adjacent;
   }
  }
  if(w.phase==0&&w.head==w.tail){w.phase=3;ReleaseSearch(w,slot);}
 }}
 float3 position=job.start.xyz,forward=job.goal.xyz-job.start.xyz;
 if((job.flags&10)!=0){
  float3 a=normalize(job.start.xyz),b=normalize(job.goal.xyz);
  float distance=max(.01,atan2(length(cross(a,b)),dot(a,b))*job.parameters.z);w.distance=distance;
  w.progress=min(distance,w.progress+_CargoDelta*job.parameters.x);
  float t=w.progress/distance;float angle=atan2(length(cross(a,b)),dot(a,b));
  float3 direction=angle<.001?normalize(lerp(a,b,t)):normalize((sin((1-t)*angle)*a+sin(t*angle)*b)/sin(angle));
  position=direction*lerp(length(job.start.xyz),length(job.goal.xyz),t);forward=b-direction*dot(b,direction);
  if(w.progress>=distance){w.arrived=1;w.phase=2;}
 }else if(w.phase==1||w.phase==2){
  float remaining=_CargoDelta*job.parameters.x;
  for(uint hop=0;hop<64&&w.phase==1;hop++){
   if(w.node==job.goalNode){w.phase=2;w.arrived=1;break;}
   if(w.routeCursor+1>=w.routeLength){w.phase=0;w.progress=0;ReleaseSearch(w,slot);break;}
   if(w.next>=routeCount||!any(RouteNode(w.node,job.flags).neighbours==(int)w.next)){
    w.phase=0;w.arrived=0;w.progress=0;ReleaseSearch(w,slot);break;
   }
   float edgeLength=max(.001,length(RouteNode(w.next,job.flags).position.xyz-RouteNode(w.node,job.flags).position.xyz));
   float travel=min(remaining,max(0,edgeLength-w.progress));w.progress+=travel;remaining-=travel;
   if(w.progress<edgeLength)break;
   w.pad=w.node+2;w.node=w.next;w.routeCursor++;w.next=RouteNext(slot,w,1);w.progress=0;
  }
  if(w.node<routeCount){position=RouteNode(w.node,job.flags).position.xyz;
   if(w.phase==1){float3 delta=RouteNode(w.next,job.flags).position.xyz-position;forward=delta;position+=delta*(w.progress/max(.001,length(delta)));}}
 }
 if((job.flags&64u)!=0&&w.phase==2&&(job.flags&4u)==0){float3 parkingStart=RouteNode(job.goalNode,job.flags).position.xyz;float lengthParking=max(.001,length(job.goal.xyz-parkingStart));w.progress=min(lengthParking,w.progress+_CargoDelta*job.parameters.x);position=lerp(parkingStart,job.goal.xyz,w.progress/lengthParking);forward=job.goal.xyz-parkingStart;w.arrived=w.progress>=lengthParking?1:0;}
 if((job.flags&68u)==68u)position=job.goal.xyz;
 bool frozen=(w.phase==0||w.phase==3)&&w.pad!=0;
 float3 up=normalize(position);
 bool ground=(job.flags&30)==0;
 if(ground&&w.node<routeCount&&(w.phase==1||w.phase==2)&&!((job.flags&64u)!=0&&w.phase==2)){
  float3 centre=RouteNode(w.node,job.flags).position.xyz;
  if(w.phase==1&&w.next<routeCount){
   float3 end=RouteNode(w.next,job.flags).position.xyz;forward=end-centre;float3 right=LaneRight(forward,up),incoming=right,outgoing=right;
   if(w.pad>=2&&w.pad-2<routeCount)incoming=LaneRight(centre-RouteNode(w.pad-2,job.flags).position.xyz,up);
   uint after=RouteNext(slot,w,2);if(w.next!=job.goalNode&&after<routeCount&&after!=w.next)outgoing=LaneRight(RouteNode(after,job.flags).position.xyz-end,up);
   float t=saturate(w.progress/max(.001,length(end-centre)));position+=lerp(LaneJoin(incoming,right),LaneJoin(right,outgoing),t);
  }else{
   if(w.pad>=2&&w.pad-2<routeCount)forward=centre-RouteNode(w.pad-2,job.flags).position.xyz;
   if(dot(forward,forward)>.00001)position+=LaneRight(forward,up)*_RoadLaneOffset;
  }
 }
 if(ground&&!frozen||(job.flags&68u)==68u)position-=up*.65;
 w.pad=max(1,w.pad);
 forward-=up*dot(forward,up);
 if(dot(forward,forward)<.00001)forward=cross(abs(up.y)>.95?float3(1,0,0):float3(0,1,0),up);
 forward=normalize(forward);Pose pose;pose.position=float4(position,1);float scale=max(1,job.start.w);pose.up=float4(up*scale,0);pose.forward=float4(forward*scale,0);pose.right=float4(normalize(cross(up,forward))*scale,0);pose.properties=float4(job.parameters.w>0?job.parameters.w:11,job.parameters.y,(job.flags&16)!=0?1:0,0);
 if(frozen)pose=_CargoPoses[slot];_CargoPoses[slot]=pose;_RoadWork[slot]=w;Summary summary;summary.version=job.version;summary.arrived=w.arrived;summary.distance=w.distance;summary.status=w.phase;if((job.flags&32u)!=0&&w.phase==1)for(uint c=0;c<_RaiderCampCount;c++)if(_RaiderCamps[c].w>0&&length(normalize(position)-_RaiderCamps[c].xyz)*job.parameters.z<_RaiderCamps[c].w){summary.status|=(c+1)<<8;break;}_RoadSummary[slot]=summary;
}

StructuredBuffer<float4> _UnusedPick;
RWStructuredBuffer<uint> _PickResult;float3 _PickOrigin,_PickDirection;uint _PickCount;
[numthreads(128,1,1)]void PickHearse(uint3 id:SV_DispatchThreadID){uint i=id.x;if(i>=_PickCount)return;Pose p=_CargoPoses[i];if(p.properties.x<32)return;float3 delta=p.position.xyz+p.up.xyz*1.5-_PickOrigin;float along=dot(delta,_PickDirection);if(along<0||along>32767)return;float3 offset=delta-_PickDirection*along;if(dot(offset,offset)>16)return;uint ignored;InterlockedMin(_PickResult[0],((uint)(along*2)<<16)|i,ignored);}
