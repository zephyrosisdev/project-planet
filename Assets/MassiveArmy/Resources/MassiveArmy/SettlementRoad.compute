#pragma kernel Navigate
#pragma kernel ClearSearch
#pragma kernel CopySearch
// A bounded, incremental reverse breadth-first search per cargo mission. Only uploaded
// same-owner road edges exist in this graph; terrain/army navigation is never sampled.
struct Node {float4 position;int4 neighbours;};
struct Job {float4 start,goal;uint version,startNode,goalNode,flags;float4 parameters;};
struct Work {uint version,head,tail,node;uint next,phase,arrived,pad;float progress,distance;uint searchEpoch,topology;};
struct Summary {uint version,arrived;float distance;uint status;};
struct Pose {float4 position,right,up,forward,properties;};
StructuredBuffer<Node> _RoadNodes,_RailNodes;uint _RailCount;
Node RouteNode(uint index,uint flags){if((flags&16)!=0)return _RailNodes[index];return _RoadNodes[index];}
StructuredBuffer<Job> _RoadJobs;
RWStructuredBuffer<Work> _RoadWork;
RWStructuredBuffer<uint> _RoadSeen,_RoadParents,_RoadQueue;
RWStructuredBuffer<float> _RoadDistances;
RWStructuredBuffer<Summary> _RoadSummary;
RWStructuredBuffer<Pose> _CargoPoses;
uint _RoadCount,_RoadStride,_CargoCount,_RoadRevision;
float _CargoDelta,_RoadLaneOffset;
StructuredBuffer<uint> _PreviousSeen,_PreviousParents,_PreviousQueue;
StructuredBuffer<float> _PreviousDistances;
StructuredBuffer<Work> _PreviousWork;
StructuredBuffer<Pose> _PreviousPoses;
uint _PreviousStride,_PreviousSlots,_SearchSlots,_StorageWidth;
[numthreads(128,1,1)]
void ClearSearch(uint3 id:SV_DispatchThreadID){uint index=id.x+id.y*_StorageWidth;if(index<_RoadStride*_SearchSlots)_RoadSeen[index]=0;if(index<_SearchSlots)_RoadWork[index]=(Work)0;}
[numthreads(128,1,1)]
void CopySearch(uint3 id:SV_DispatchThreadID){uint index=id.x+id.y*_StorageWidth;
 if(index>=_PreviousStride*_PreviousSlots)return;uint slot=index/_PreviousStride,cell=index%_PreviousStride,target=slot*_RoadStride+cell;
 _RoadSeen[target]=_PreviousSeen[index];_RoadParents[target]=_PreviousParents[index];_RoadQueue[target]=_PreviousQueue[index];_RoadDistances[target]=_PreviousDistances[index];
 if(cell==0){_RoadWork[slot]=_PreviousWork[slot];_CargoPoses[slot]=_PreviousPoses[slot];}
}
// Bevelled lane joins use the same route parents as the centreline search.
float3 LaneRight(float3 direction,float3 up){direction-=up*dot(up,direction);return normalize(cross(up,normalize(direction)));}
float3 LaneJoin(float3 a,float3 b){float3 sum=a+b;float lengthSum=length(sum);if(lengthSum<.001)return b*_RoadLaneOffset;float3 m=sum/lengthSum;return m*(_RoadLaneOffset/max(.7071,dot(m,b)));}
[numthreads(32,1,1)]
void Navigate(uint slot:SV_DispatchThreadID){
 if(slot>=_CargoCount)return;
 Job job=_RoadJobs[slot];uint routeCount=(job.flags&16)!=0?_RailCount:_RoadCount;Work w=_RoadWork[slot];uint baseIndex=slot*_RoadStride;
 if(w.version!=job.version){
  uint previousEpoch=w.searchEpoch,previousVersion=w.version;w=(Work)0;w.pad=previousVersion!=0?1:0;w.version=job.version;w.searchEpoch=previousEpoch+1;w.topology=_RoadRevision;w.node=job.startNode;
  if((job.flags&4)!=0){w.phase=2;w.arrived=1;}
  else if((job.flags&10)!=0)w.phase=1;
  else if(job.startNode>=routeCount||job.goalNode>=routeCount)w.phase=3;
  else if((uint)RouteNode(job.startNode,job.flags).position.w!=(uint)job.parameters.y||(uint)RouteNode(job.goalNode,job.flags).position.w!=(uint)job.parameters.y)w.phase=3;
  else {uint goal=baseIndex+job.goalNode;_RoadSeen[goal]=w.searchEpoch;_RoadParents[goal]=job.goalNode;_RoadDistances[goal]=0;_RoadQueue[baseIndex]=job.goalNode;w.tail=1;}
 }
 // Completed/moving missions keep their GPU position across topology changes. Failed
 // or pending searches retry from their unmoved start with a fresh per-slot epoch.
 if(w.topology!=_RoadRevision){w.topology=_RoadRevision;if((job.flags&14)==0&&(w.phase==0||w.phase==3)&&w.node<routeCount&&job.goalNode<routeCount){
  w.searchEpoch++;w.head=0;w.tail=1;w.phase=0;w.arrived=0;uint goal=baseIndex+job.goalNode;_RoadSeen[goal]=w.searchEpoch;_RoadParents[goal]=job.goalNode;_RoadDistances[goal]=0;_RoadQueue[baseIndex]=job.goalNode;
 }}
 if(w.phase==0){
  for(uint budget=0;budget<128&&w.head<w.tail;budget++){
   uint node=_RoadQueue[baseIndex+w.head++];
   if(node==w.node){w.node=node;w.next=_RoadParents[baseIndex+node];w.distance=_RoadDistances[baseIndex+node];w.phase=1;break;}
   Node road=RouteNode(node,job.flags);
   for(uint edge=0;edge<4;edge++){
    int adjacent=road.neighbours[edge];if(adjacent<0)continue;uint index=baseIndex+(uint)adjacent;
    if(_RoadSeen[index]==w.searchEpoch)continue;
    _RoadSeen[index]=w.searchEpoch;_RoadParents[index]=node;
    _RoadDistances[index]=_RoadDistances[baseIndex+node]+length(RouteNode(adjacent,job.flags).position.xyz-road.position.xyz);
    _RoadQueue[baseIndex+w.tail++]=(uint)adjacent;
   }
  }
  if(w.phase==0&&w.head==w.tail)w.phase=3;
 }
 float3 position=job.start.xyz,forward=job.goal.xyz-job.start.xyz;
 if((job.flags&10)!=0){
  float3 a=normalize(job.start.xyz),b=normalize(job.goal.xyz);
  float distance=max(.01,atan2(length(cross(a,b)),dot(a,b))*job.parameters.z);w.distance=distance;
  w.progress=min(distance,w.progress+_CargoDelta*job.parameters.x);
  float t=w.progress/distance;float angle=atan2(length(cross(a,b)),dot(a,b));
  float3 direction=angle<.001?normalize(lerp(a,b,t)):normalize((sin((1-t)*angle)*a+sin(t*angle)*b)/sin(angle));
  position=direction*lerp(length(job.start.xyz),length(job.goal.xyz),t);forward=b-direction*dot(b,direction);
  if(w.progress>=distance){w.arrived=1;w.phase=2;}
 }else if(w.phase==1||w.phase==2){
  float remaining=_CargoDelta*job.parameters.x;
  for(uint hop=0;hop<64&&w.phase==1;hop++){
   if(w.node==job.goalNode){w.phase=2;w.arrived=1;break;}
   if(w.next>=routeCount||!any(RouteNode(w.node,job.flags).neighbours==(int)w.next)){
    w.phase=0;w.arrived=0;w.progress=0;w.searchEpoch++;w.head=0;w.tail=1;uint goal=baseIndex+job.goalNode;_RoadSeen[goal]=w.searchEpoch;_RoadParents[goal]=job.goalNode;_RoadDistances[goal]=0;_RoadQueue[baseIndex]=job.goalNode;break;
   }
   float edgeLength=max(.001,length(RouteNode(w.next,job.flags).position.xyz-RouteNode(w.node,job.flags).position.xyz));
   float travel=min(remaining,max(0,edgeLength-w.progress));w.progress+=travel;remaining-=travel;
   if(w.progress<edgeLength)break;
   w.pad=w.node+2;w.node=w.next;w.next=_RoadParents[baseIndex+w.node];w.progress=0;
  }
  if(w.node<routeCount){position=RouteNode(w.node,job.flags).position.xyz;
   if(w.phase==1){float3 delta=RouteNode(w.next,job.flags).position.xyz-position;forward=delta;position+=delta*(w.progress/max(.001,length(delta)));}}
 }
 bool frozen=(w.phase==0||w.phase==3)&&w.pad!=0;
 float3 up=normalize(position);
 bool ground=(job.flags&30)==0;
 if(ground&&w.node<routeCount&&(w.phase==1||w.phase==2)){
  float3 centre=RouteNode(w.node,job.flags).position.xyz;
  if(w.phase==1&&w.next<routeCount){
   float3 end=RouteNode(w.next,job.flags).position.xyz;forward=end-centre;float3 right=LaneRight(forward,up),incoming=right,outgoing=right;
   if(w.pad>=2&&w.pad-2<routeCount)incoming=LaneRight(centre-RouteNode(w.pad-2,job.flags).position.xyz,up);
   uint after=_RoadParents[baseIndex+w.next];if(w.next!=job.goalNode&&after<routeCount&&after!=w.next)outgoing=LaneRight(RouteNode(after,job.flags).position.xyz-end,up);
   float t=saturate(w.progress/max(.001,length(end-centre)));position+=lerp(LaneJoin(incoming,right),LaneJoin(right,outgoing),t);
  }else{
   if(w.pad>=2&&w.pad-2<routeCount)forward=centre-RouteNode(w.pad-2,job.flags).position.xyz;
   if(dot(forward,forward)>.00001)position+=LaneRight(forward,up)*_RoadLaneOffset;
  }
 }
 if(ground&&!frozen)position-=up*.65;
 w.pad=max(1,w.pad);
 forward-=up*dot(forward,up);
 if(dot(forward,forward)<.00001)forward=cross(abs(up.y)>.95?float3(1,0,0):float3(0,1,0),up);
 forward=normalize(forward);Pose pose;pose.position=float4(position,1);float scale=max(1,job.start.w);pose.up=float4(up*scale,0);pose.forward=float4(forward*scale,0);pose.right=float4(normalize(cross(up,forward))*scale,0);pose.properties=float4(job.parameters.w>0?job.parameters.w:11,job.parameters.y,(job.flags&16)!=0?1:0,0);
 if(frozen)pose=_CargoPoses[slot];_CargoPoses[slot]=pose;_RoadWork[slot]=w;Summary summary;summary.version=job.version;summary.arrived=w.arrived;summary.distance=w.distance;summary.status=w.phase;_RoadSummary[slot]=summary;
}
