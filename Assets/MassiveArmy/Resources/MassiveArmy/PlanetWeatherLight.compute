#pragma multi_compile _ PLANET_GPU_DOUBLE
#pragma kernel BuildLight
#pragma kernel ValidateProfile
Texture3D<float> _WeatherNoise;SamplerState sampler_WeatherNoise;
RWTexture3D<float> _WeatherLightWrite;
float4 _WeatherAtmosphere,_WeatherCloud,_WeatherWind;
float _WeatherRadius,_WeatherNoiseLod;
float3 _WeatherSun;float4 _WeatherLightSize;int _WeatherLightRowOffset,_WeatherLightRowCount;
#include "PlanetWeatherDensity.hlsl"
// One bounded, low-frequency optical-depth field for the resident planet.
// Trilinear filtering makes terrain shadows soft; no screen-sized light march.
[numthreads(8,8,1)]void BuildLight(uint3 id:SV_DispatchThreadID){
 if(_WeatherLightRowCount>0&&id.y>=(uint)_WeatherLightRowCount)return;
 id.y+=(uint)max(0,_WeatherLightRowOffset);
 uint3 size=_WeatherLightSize.x>0?(uint3)_WeatherLightSize.xyz:uint3(128,64,8);if(any(id>=size))return;
 float longitude=((id.x+.5)/size.x-.5)*6.283185307,latitude=((id.y+.5)/size.y-.5)*3.141592654;
 float3 up=float3(cos(latitude)*cos(longitude),sin(latitude),cos(latitude)*sin(longitude));
 float bottom=1+_WeatherAtmosphere.z,top=bottom+_WeatherAtmosphere.w;
 float3 p=up*(bottom+_WeatherAtmosphere.w*(id.z/(float)(size.z-1)));float2 ground,outer,inner;
 if(WeatherSphereFrom(p,_WeatherSun,1,ground)&&ground.x>0){_WeatherLightWrite[id]=16;return;}
 if(!WeatherSphereFrom(p,_WeatherSun,top,outer)){_WeatherLightWrite[id]=0;return;}
 float start=max(0,outer.x),end=max(start,outer.y),gapStart=end,gapEnd=end;
 if(WeatherSphereFrom(p,_WeatherSun,bottom,inner)){gapStart=clamp(inner.x,start,end);gapEnd=clamp(inner.y,start,end);}
 float first=gapStart-start,gap=gapEnd-gapStart,distance=end-start-gap,tau=0;
 [unroll]for(int i=0;i<6;i++){float path=(i+.5)*distance/6,t=start+path+(path>=first?gap:0);tau+=CloudDensity(p+_WeatherSun*t)*distance/6;}
 _WeatherLightWrite[id]=min(16,tau*_WeatherCloud.y);
}

RWStructuredBuffer<float4> _ProfileValidation;
[numthreads(1,1,1)]void ValidateProfile(uint3 id:SV_DispatchThreadID){float3 shape=float3(1,0,1);_ProfileValidation[0]=float4(CloudVerticalFiltered(.5,shape,1.5),CloudVerticalFiltered(-1,shape,.1),CloudVerticalFiltered(2,shape,.1),CloudVerticalFiltered(.5,shape,.01));float2 shell;WeatherRayShell(float3(0,-1,0),0,float3(0,1,0),2000.0/120000000.0,shell);_ProfileValidation[1]=float4(shell*120000000.0,0,0);}
